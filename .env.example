# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.

# Neon Postgres, pooled endpoint (contains "-pooler"). Used by the app at
# runtime. The client sets prepare: false because Neon's pooler runs PgBouncer
# in transaction mode.
DATABASE_URL=

# Neon Postgres, direct endpoint. Used by drizzle-kit and scripts/migrate.ts
# for DDL, which is happiest over a plain session. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Neon Postgres for the test suite. Belongs in .env.test, not .env.local.
#
# This MUST be a separate Neon project — the E2E harness drops and recreates
# its schema between runs. `pnpm db:reset:test` refuses to run, without
# touching anything, when this value is identical to DATABASE_URL.
#
# A Vercel/Neon env pull writes the same URL into .env.local under the name
# TEST_DATABASE_URL; the scripts accept either spelling.
DATABASE_URL_TEST=

# Optional direct endpoint for the test database. Falls back to
# DATABASE_URL_TEST (or TEST_DATABASE_URL_UNPOOLED) when unset.
DATABASE_URL_TEST_UNPOOLED=

# Vercel AI Gateway credential for the EVE agent.
AI_GATEWAY_API_KEY=

# Optional. Overrides the agent model without a code change.
# Defaults to anthropic/claude-sonnet-5.
EVE_MODEL=
