# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.

# Neon Postgres, pooled endpoint (contains "-pooler"). Used by the app at
# runtime. The client sets prepare: false because Neon's pooler runs PgBouncer
# in transaction mode.
DATABASE_URL=

# Neon Postgres, direct endpoint. Used by drizzle-kit for migrations, which
# are happiest over a plain session. Falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=

# Vercel AI Gateway credential for the EVE agent.
AI_GATEWAY_API_KEY=

# Optional. Overrides the agent model without a code change.
# Defaults to anthropic/claude-sonnet-5.
EVE_MODEL=
