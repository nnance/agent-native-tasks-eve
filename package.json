{
  "name": "agent-native-tasks-eve",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env.local --env-file-if-exists=.env.test --test \"tests/unit/**/*.test.ts\" \"tests/api/**/*.test.ts\"",
    "test:unit": "node --env-file=.env.local --env-file-if-exists=.env.test --test \"tests/unit/**/*.test.ts\"",
    "test:api": "node --env-file=.env.local --env-file-if-exists=.env.test --test \"tests/api/**/*.test.ts\"",
    "test:e2e": "next build && node --env-file=.env.local --env-file-if-exists=.env.test --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "test:e2e:only": "node --env-file=.env.local --env-file-if-exists=.env.test --test --test-concurrency=1 \"tests/e2e/**/*.test.ts\"",
    "test:all": "pnpm test && pnpm test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env.local scripts/seed.ts",
    "db:reset": "node --env-file=.env.local scripts/reset.ts",
    "db:reset:test": "node --env-file=.env.local --env-file-if-exists=.env.test scripts/reset.ts --target=test"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.40",
    "@base-ui/react": "^1.6.0",
    "@shadcn/helpers": "^0.1.0",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/connect": "0.4.2",
    "ai": "^7.0.37",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "eve": "^0.27.8",
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "0.33.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
